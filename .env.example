NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
# Paystack secret key (sk_test_... for testing). Without it, "Pay online" is disabled.
PAYSTACK_SECRET_KEY=
SHIPPING_FEE=0
REFERRAL_REWARD=1000

# Supabase server credentials. Leave blank to use the local data/*.json store.
# Use the service-role key only on the backend; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
